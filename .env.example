# ===================================================
# LastHope - Environment Configuration Template
# ===================================================
# Copy this file to '.env' and fill in your actual values:
# cp .env.example .env

# Your Groq API Key (Obtain from: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Configuration (Tested active runtime model)
GROQ_MODEL=openai/gpt-oss-120b
